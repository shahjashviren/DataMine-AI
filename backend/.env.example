# Backend environment variables
# Copy this file to .env and fill in real values before running.

# Required — Groq API key (free tier at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional — where pipeline outputs are written (default: ./outputs)
# On Render (ephemeral filesystem) set this to /tmp/outputs
OUTPUT_DIR=outputs

# Optional — Openverse API credentials for higher rate limits on image collection.
# Register at https://api.openverse.org/v1/auth_tokens/register/ (free).
# Without these the pipeline uses anonymous access (lower rate limit, still works).
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Optional — Hugging Face API token for text embedding (deduplication step).
# Without it the pipeline uses the anonymous free tier of the HF Inference API,
# which works for small batches but may be rate-limited under heavy load.
# Get a free token at https://huggingface.co/settings/tokens (read-only is enough).
HF_API_TOKEN=

# Semantic Scholar and Wikimedia Commons APIs require no key.
# DuckDuckGo search requires no key.
